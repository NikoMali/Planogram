{
  "ConnectionStrings": {
    "WebApiDatabase": "server=localhost; database=ProductTermsControl; uid=root; pwd=***;"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.MySQL"
    ],
    "MinimumLevel": "Information", //Error, Information
    "WriteTo": [
      {
        "Name": "MySQL",
        "Args": {
          "autoCreateTable": true,
          "tableName": "Logs",
          "restrictedToMinimumLevel": "Error",
          "connectionString": "server=localhost; database=Planograma; uid=root; pwd=###;",
          "batchPostingLimit": 1000,
          "period": "0.00:00:30",
          "options": {

            "TimestampInUtc": true,
            "ExcludePropertiesWithDedicatedColumn": true,
            "EnumsAsInts": true,
            "LogRecordsCleanupFrequency": "0.02:00:00",
            "LogRecordsExpiration": "31.00:00:00"
          }
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
